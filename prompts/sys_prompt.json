  "sony_liv_movies": {
    "title": "Sony LIV Movies Screen",
    "description": "Sony LIV movies browsing screen showing promotional banner and horizontal movie carousels",
    "screen_type": "content_browse",
    "visible_contents": {
      "mandatory": [
        "sony_liv_logo",
        "large_promotional_banner",
        "movie_or_content_tiles",
        "focused_tile_highlight"
      ],
      "optional": [
        "category_label_text",
        "language_or_genre_text",
        "carousel_navigation_arrow",
        "imdb_or_rating_section"
      ]
    },
    "ui_characteristics": [
      "large hero banner occupying upper portion of screen",
      "horizontal carousel of movie tiles below banner",
      "one tile is visually highlighted with border or glow",
      "background is static promotional artwork"
    ],
    "focus_rules": {
      "initial_focus": "first_movie_tile_in_carousel",
      "navigation_behavior": [
        "LEFT and RIGHT navigate between movie tiles",
        "UP moves focus away from tiles toward banner or tabs",
        "DOWN moves focus to next content row"
      ]
    },
    "assertion_rules": [
      "Do not require exact banner text match",
      "Banner title and promotional text may change",
      "Ignore specific movie names or artwork",
      "Validate based on layout, banner presence, and tile structure",
      "Ignore reflections and camera artifacts"
    ],
    "confidence_guidelines": {
      "high": "Banner, movie tiles, and focused highlight are clearly visible",
      "medium": "Tiles visible but banner partially obscured",
      "low": "Only video or unrelated UI elements visible"
    }
  },
  "sony_liv_video_player": {
    "title": "Video Player Screen",
    "description": "Full-screen media playback screen with overlay controls",
    "screen_type": "player",
    "visible_contents": {
      "mandatory": [
        "play_or_pause_button",
        "progress_bar_or_timeline",
        "back_icon",
        "media_title_text"
      ],
      "optional": [
        "audio_settings",
        "subtitle_settings",
        "duration_time",
        "current_play_time",
        "age_rating_badge"
      ]
    },
    "ui_characteristics": [
      "controls overlay appears on interaction",
      "video content occupies most of the screen",
      "background is moving video frames",
      "controls may auto-hide after inactivity"
    ],
    "focus_rules": {
      "initial_focus": "play_pause_button_or_timeline",
      "navigation_behavior": [
        "LEFT or RIGHT moves along timeline",
        "UP opens control options",
        "BACK exits player"
      ]
    },
    "assertion_rules": [
      "Do not require exact title match",
      "Title text may vary depending on content",
      "Ignore characters, faces, or scene visuals",
      "Ignore reflections and camera artifacts",
      "Validate based on UI controls and structure"
    ],
    "confidence_guidelines": {
      "high": "Play/Pause, timeline, and back icon are all clearly visible",
      "medium": "Most controls visible but partially occluded",
      "low": "Only video content visible without clear controls"
    }
  }
