  "sony_liv_home": {
    "title": "Sony LIV Home Screen",
    "description": "Sony LIV movies browsing screen with a large hero movie banner and horizontal movie carousel",
    "screen_type": "content_browse_with_hero",
    "visible_contents": {
      "mandatory": [
        "sony_liv_logo",
        "subscribe_button",
        "large_hero_movie_banner",
        "movie_title_text",
        "language_and_genre_text",
        "horizontal_movie_carousel",
        "focused_movie_tile",
        "Trending In India Today section"
      ],
      "optional": [
        "age_rating_badge",
        "streaming_status_text",
        "play_icon_on_tiles",
        "carousel_navigation_arrow",
        "trending_section_label"
      ]
    },
    "hero_section_characteristics": [
      "occupies majority of right side of screen",
      "contains a large movie poster or character image",
      "contains movie title text",
      "contains language and genre text (e.g. Malayalam, Crime, Thriller)",
      "background artwork is static and promotional"
    ],
    "carousel_characteristics": [
      "horizontal row of movie thumbnails near bottom",
      "one thumbnail is visually highlighted with a white border or glow",
      "each tile may contain a play icon",
      "LEFT and RIGHT navigate between tiles"
    ],
    "focus_rules": {
      "initial_focus": "one_movie_tile_in_carousel",
      "navigation_behavior": [
        "LEFT and RIGHT move between movie tiles",
        "UP moves focus toward hero/banner area",
        "DOWN moves focus to next content section"
      ]
    },
    "assertion_rules": [
      "Movie title text may vary and should NOT be matched exactly",
      "Hero artwork may change and should NOT be matched by face or actor",
      "At least ONE movie title text must be visible",
      "At least ONE horizontal carousel must be visible",
      "At least ONE focused tile highlight must be visible",
      "Ignore reflections, camera glare, and room background",
      "Do NOT confuse this screen with video player or subscription paywall"
    ],
    "negative_indicators": [
      "video playback timeline",
      "pause or play progress bar",
      "audio or subtitle settings menu",
      "full screen video playback"
    ],
    "confidence_guidelines": {
      "high": "Hero banner, movie title text, and focused carousel tile are all clearly visible",
      "medium": "Hero banner and carousel visible but text partially blurred",
      "low": "Only video playback controls or unrelated UI visible"
    }
  },
